# TraderKirala frontend ortam değişkenleri
# Kopyala: cp .env.example .env
# Expo yalnızca EXPO_PUBLIC_ ile başlayan değişkenleri istemciye açar.

# --- Stellar ağı (hackathon: testnet) ---
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
EXPO_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# --- Backend API (SEP-10 auth, listings, tx/submit, anchor proxy) ---
# Origin verilir; uç noktalar /api/v1 önekini kendisi ekler (GET /api/v1/config).
# Yerel geliştirme: http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=https://mobilback.yolalapp.com

# --- Soroban kontrat ID'leri (backend ilk deploy sonrası doldurur) ---
EXPO_PUBLIC_CONTRACT_LISTING_ID=
EXPO_PUBLIC_CONTRACT_ESCROW_ID=

# --- Anchor (SEP-1 / SEP-10 / SEP-24) ---
EXPO_PUBLIC_ANCHOR_HOME_DOMAIN=

# --- OpenZeppelin Relayer (ücret sponsorluğu; backend üzerinden kullanılır) ---
EXPO_PUBLIC_RELAYER_ADDRESS=

# --- WalletConnect v2 (mobil cüzdan; https://cloud.reown.com) ---
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
