# ---- copy to .env and fill (scripts/gen_env.py generates a complete file) ----
APP_ENV=prod
LOG_LEVEL=INFO
DOCS_ENABLED=true

POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me-at-least-32-chars
ADMIN_KEY=change-me-admin-key

# Stellar
STELLAR_NETWORK=testnet            # testnet | public
HOME_DOMAIN=mobilback.yolalapp.com
WEB_AUTH_DOMAIN=mobilback.yolalapp.com
SEP10_SERVER_SECRET=S...           # signing key advertised in stellar.toml
PLATFORM_SECRET=S...               # funds new pool accounts (testnet: friendbot-funded)
POOL_KEY_ENCRYPTION_KEY=urlsafe-base64-32-bytes
POOL_FUNDING_XLM=20
PLATFORM_FEE_PCT=0
DEFAULT_SLIPPAGE_PCT=1.0

# Expo push (optional)
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Soroban vault contract (written by scripts/deploy_contract.sh; see deploy/contract.<network>.json)
VAULT_CONTRACT_ID=
SOROSWAP_ROUTER_ID=                # empty -> per-network Soroswap router default
SOROSWAP_API_KEY=                  # optional: Soroswap API quotes
DEFAULT_BASE_ASSET_CODE=XLM        # testnet: XLM (Soroswap liquidity); mainnet: USDC

# Anchor (SEP-1/10/24/12) — Yatır / Çek
ANCHOR_ENABLED=true
ANCHOR_HOME_DOMAIN=testanchor.stellar.org
ANCHOR_ASSETS=native,USDC
ANCHOR_LANG=tr

# Worker intervals (seconds)
INDEXER_POLL_SECONDS=5
RECONCILE_SECONDS=60
ANCHOR_SYNC_SECONDS=20
FX_CACHE_SECONDS=600
